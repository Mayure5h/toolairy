---
import ToolLayout from "../layouts/ToolLayout.astro";
import { TOOLS } from "../data/tools.js";
---
<ToolLayout
  title="Free Online File Tools That Run in Your Browser"
  description="Free online tools to rename files, merge PDFs, convert CSV to JSON, and compare CSV files. Everything runs in your browser, so your files are never uploaded."
>
  <section class="hero">
    <div class="hero-text">
      <h1>Free file tools that work right in your browser</h1>
      <p class="hero-sub">
        Rename files, merge PDFs, convert and compare CSVs. Nothing is uploaded, nothing is
        stored, and there is nothing to sign up for.
      </p>
      <ul class="chips">
        <li><span style="--d:#2cb1f5"></span>No uploads</li>
        <li><span style="--d:#12b886"></span>No sign-up</li>
        <li><span style="--d:#ffb020"></span>Free to use</li>
      </ul>
    </div>

    <div class="hero-art" aria-hidden="true">
      {TOOLS.map((t, i) => (
        <span class={`tile t${i}`} style={`--c: ${t.color};`}>{t.glyph}</span>
      ))}
    </div>
  </section>

  <section class="tools" aria-labelledby="all-tools">
    <h2 id="all-tools">All tools</h2>
    <div class="grid">
      {TOOLS.map((t) => (
        <a class="card" href={t.href} style={`--c: ${t.color};`}>
          <span class="card-tile">{t.glyph}</span>
          <h3>{t.name}</h3>
          <p>{t.desc}</p>
          <span class="card-go">Open tool</span>
        </a>
      ))}
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">Private by design</h2>
    <div class="why-grid">
      <div>
        <h3>Your files stay with you</h3>
        <p>Every tool runs inside your browser tab. Your documents and data are never sent to a server.</p>
      </div>
      <div>
        <h3>Nothing to install</h3>
        <p>Open a tool, drop in your files, and download the result. It works on your phone too.</p>
      </div>
      <div>
        <h3>More tools on the way</h3>
        <p>New tools are added regularly. Have an idea? Send it through the contact page.</p>
      </div>
    </div>
  </section>
</ToolLayout>

<style>
  .hero {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px;
    align-items: center; padding: 48px 0 28px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5.2vw, 3.6rem);
    line-height: 1.04; letter-spacing: -0.03em;
    margin: 0 0 16px; color: var(--ink);
  }
  .hero-sub { font-size: 1.15rem; color: var(--muted); max-width: 560px; margin: 0 0 20px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; flex-wrap: wrap; }
  .chips li {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; border: 1px solid var(--border); border-radius: 999px;
    padding: 7px 14px; font-weight: 600; font-size: 0.92rem;
  }
  .chips span { width: 9px; height: 9px; border-radius: 50%; background: var(--d); }

  .hero-art { position: relative; width: 300px; height: 270px; justify-self: center; }
  .tile {
    position: absolute; width: 112px; height: 112px; border-radius: 28px;
    background: var(--c); color: #fff; display: grid; place-items: center;
    font: 800 2rem var(--font-display);
    box-shadow: 0 18px 30px -14px color-mix(in srgb, var(--c) 70%, black);
  }
  .t0 { left: 0; top: 30px; rotate: -8deg; }
  .t1 { left: 120px; top: 0; rotate: 6deg; }
  .t2 { left: 20px; top: 146px; rotate: 5deg; }
  .t3 { left: 150px; top: 130px; rotate: -6deg; }

  .tools h2, .why h2 {
    font-family: var(--font-display); font-size: 1.7rem; letter-spacing: -0.02em;
    margin: 36px 0 16px; color: var(--ink);
  }
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .card {
    display: flex; flex-direction: column; gap: 8px;
    background: color-mix(in srgb, var(--c) 7%, white);
    border: 1px solid color-mix(in srgb, var(--c) 24%, white);
    border-radius: 20px; padding: 20px; text-decoration: none; color: var(--ink);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover { border-color: var(--c); transform: translateY(-2px); }
  .card-tile {
    width: 52px; height: 52px; border-radius: 14px; background: var(--c); color: #fff;
    display: grid; place-items: center; font: 800 1.15rem var(--font-display);
  }
  .card h3 { margin: 6px 0 0; font-family: var(--font-display); font-size: 1.2rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.95rem; flex: 1; }
  .card-go { font-weight: 700; color: var(--c); }

  .why-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .why-grid h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .why-grid p { margin: 0; color: var(--muted); }
  .why-grid > div { border-left: 4px solid var(--border); padding-left: 16px; }
  .why-grid > div:nth-child(1) { border-color: #2cb1f5; }
  .why-grid > div:nth-child(2) { border-color: #12b886; }
  .why-grid > div:nth-child(3) { border-color: #ffb020; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-top: 28px; }
    .hero-art { display: none; }
  }
</style>