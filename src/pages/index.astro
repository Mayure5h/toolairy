---
import ToolLayout from "../layouts/ToolLayout.astro";

const tools = [
  { name: "Bulk File Renamer", href: "/bulk-file-renamer", desc: "Rename many files at once with prefixes, numbering, and find and replace." },
  { name: "CSV to JSON", href: "/csv-to-json", desc: "Convert CSV data to JSON instantly." },
  { name: "PDF Merger", href: "/pdf-merger", desc: "Combine several PDFs into one file." },
  { name: "CSV Compare", href: "/csv-compare", desc: "Find added, removed, and changed rows between two CSV files." },
];
---
<ToolLayout
  title="Free Online Tools That Run in Your Browser"
  description="Free online tools for files, PDFs, and data. Everything runs in your browser, so your files are never uploaded."
>
  <h1>Useful Tools. Zero Fuss.</h1>
  <p class="intro">Fast, free tools that run entirely in your browser. Your files never leave your device.</p>

  <div class="grid">
    {tools.map((t) => (
      <a class="card" href={t.href}>
        <h2>{t.name}</h2>
        <p>{t.desc}</p>
      </a>
    ))}
  </div>
</ToolLayout>

<style>
  .intro { color: var(--muted); margin-bottom: 24px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
  }
  .card:hover { border-color: var(--accent); }
  .card h2 { margin: 0 0 6px; font-size: 1.1rem; color: var(--accent); }
  .card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
</style>