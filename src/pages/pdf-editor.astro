---
import ToolLayout from "../layouts/ToolLayout.astro";
---
<ToolLayout
  wide
  title="PDF Editor: Edit, Sign, Annotate and Reorder PDFs Online Free"
  description="Free online PDF editor. Add text, draw, highlight, sign, redact, add stamps and watermarks, and reorder, rotate, merge, or split pages. Runs in your browser, files are never uploaded."
>
  <h1>PDF Editor</h1>
  <p class="pe-intro">
    Open a PDF and add text, drawings, images, stamps, and signatures, or reorder, rotate, merge,
    and split pages. Everything runs in your browser, so your file is never uploaded.
  </p>

  <div class="pe-app" id="pe-app">
    <div class="pe-bar" role="toolbar" aria-label="File and view controls">
      <div class="pe-group">
        <button id="pe-open" class="pe-btn" type="button">Open file</button>
        <button id="pe-add" class="pe-btn" type="button" data-needs-doc>Add pages</button>
        <button id="pe-download" class="pe-btn pe-primary" type="button" data-needs-doc>Download</button>
      </div>
      <div class="pe-group">
        <button id="pe-undo" class="pe-btn" type="button" title="Undo (Ctrl+Z)" disabled>Undo</button>
        <button id="pe-redo" class="pe-btn" type="button" title="Redo (Ctrl+Y)" disabled>Redo</button>
      </div>
      <div class="pe-group">
        <button id="pe-zout" class="pe-btn" type="button" aria-label="Zoom out" data-needs-doc>-</button>
        <select id="pe-zoom" class="pe-select" aria-label="Zoom" data-needs-doc>
          <option value="fit">Fit width</option>
          <option value="0.5">50%</option>
          <option value="0.75">75%</option>
          <option value="1">100%</option>
          <option value="1.25">125%</option>
          <option value="1.5">150%</option>
          <option value="2">200%</option>
          <option value="3">300%</option>
          <option value="4">400%</option>
          <option value="custom" id="pe-zcustom" hidden>Custom</option>
        </select>
        <button id="pe-zin" class="pe-btn" type="button" aria-label="Zoom in" data-needs-doc>+</button>
      </div>
      <div class="pe-group">
        <button id="pe-rotl" class="pe-btn" type="button" data-needs-doc title="Rotate the current page left">Rotate left</button>
        <button id="pe-rotr" class="pe-btn" type="button" data-needs-doc title="Rotate the current page right">Rotate right</button>
      </div>
      <span id="pe-pageinfo" class="pe-pageinfo">No file open</span>
    </div>

    <div class="pe-bar pe-tools" role="toolbar" aria-label="Editing tools">
      <div class="pe-group">
        <button class="pe-btn" type="button" data-tool="select" data-needs-doc aria-pressed="true">Select</button>
        <button class="pe-btn" type="button" data-tool="edittext" data-needs-doc aria-pressed="false">Edit text</button>
        <button class="pe-btn" type="button" data-tool="text" data-needs-doc aria-pressed="false">Text</button>
        <button class="pe-btn" type="button" data-tool="stamp" data-needs-doc aria-pressed="false">Stamp</button>
      </div>
      <div class="pe-group">
        <button class="pe-btn" type="button" data-tool="pen" data-needs-doc aria-pressed="false">Pen</button>
        <button class="pe-btn" type="button" data-tool="hl" data-needs-doc aria-pressed="false">Highlighter</button>
        <button class="pe-btn" type="button" data-tool="rect" data-needs-doc aria-pressed="false">Rectangle</button>
        <button class="pe-btn" type="button" data-tool="ellipse" data-needs-doc aria-pressed="false">Ellipse</button>
        <button class="pe-btn" type="button" data-tool="line" data-needs-doc aria-pressed="false">Line</button>
        <button class="pe-btn" type="button" data-tool="arrow" data-needs-doc aria-pressed="false">Arrow</button>
      </div>
      <div class="pe-group">
        <button class="pe-btn" type="button" data-tool="white" data-needs-doc aria-pressed="false">Whiteout</button>
        <button class="pe-btn" type="button" data-tool="redact" data-needs-doc aria-pressed="false">Redact</button>
      </div>
      <div class="pe-group">
        <button id="pe-sign" class="pe-btn" type="button" data-needs-doc>Signature</button>
        <button id="pe-image" class="pe-btn" type="button" data-needs-doc>Image</button>
      </div>
    </div>

    <div class="pe-main">
      <aside class="pe-left" aria-label="Pages">
        <div class="pe-pageops">
          <button id="pe-up" class="pe-btn pe-sm" type="button" data-needs-doc>Move up</button>
          <button id="pe-down" class="pe-btn pe-sm" type="button" data-needs-doc>Move down</button>
          <button id="pe-dupe" class="pe-btn pe-sm" type="button" data-needs-doc>Duplicate</button>
          <button id="pe-blank" class="pe-btn pe-sm" type="button" data-needs-doc>Add blank</button>
          <button id="pe-extract" class="pe-btn pe-sm" type="button" data-needs-doc>Extract</button>
          <button id="pe-del-page" class="pe-btn pe-sm" type="button" data-needs-doc>Delete</button>
        </div>
        <div id="pe-thumbs" class="pe-thumbs"></div>
      </aside>

      <div id="pe-stage" class="pe-stage" data-tool="select">
        <div id="pe-empty" class="pe-empty">
          <div>
            <p class="pe-empty-title">Drop a PDF or image here</p>
            <p>Or choose a file from your device. Nothing is uploaded.</p>
            <button id="pe-empty-open" class="pe-btn pe-primary" type="button">Choose a file</button>
          </div>
        </div>
        <div id="pe-pages" class="pe-pages" hidden></div>
      </div>

      <aside id="pe-inspector" class="pe-right" aria-label="Properties">
        <h2 class="pe-h">Properties</h2>
        <p id="pe-hint" class="pe-note">Pick a tool, or select an item on the page, to change its settings.</p>

        <label class="pe-field" data-g="stamp">Stamp
          <select id="pe-stamp">
            <option value="approved">Approved</option>
            <option value="confidential">Confidential</option>
            <option value="draft">Draft</option>
            <option value="rejected">Rejected</option>
            <option value="paid">Paid</option>
            <option value="copy">Copy</option>
          </select>
        </label>
        <label class="pe-field" data-g="text">Text
          <textarea id="pe-text" rows="3" spellcheck="false"></textarea>
        </label>
        <label class="pe-field" data-g="color">Color
          <input id="pe-color" type="color" value="#e03131" />
        </label>
        <label class="pe-field" data-g="sw">Line width
          <input id="pe-sw" type="range" min="1" max="30" value="3" />
        </label>
        <label class="pe-field" data-g="opacity">Opacity
          <input id="pe-opacity" type="range" min="10" max="100" value="100" />
        </label>
        <label class="pe-check" data-g="fill"><input id="pe-fill" type="checkbox" /> Fill shape</label>
        <label class="pe-field" data-g="font">Font
          <select id="pe-font">
            <option value="Helvetica">Sans-serif</option>
            <option value="Times">Serif</option>
            <option value="Courier">Monospace</option>
            <option value="Handwriting">Handwriting</option>
          </select>
        </label>
        <label class="pe-field" data-g="size">Text size
          <input id="pe-size" type="number" min="6" max="300" value="18" />
        </label>
        <div class="pe-row" data-g="style">
          <label class="pe-check"><input id="pe-bold" type="checkbox" /> Bold</label>
          <label class="pe-check"><input id="pe-italic" type="checkbox" /> Italic</label>
        </div>
        <label class="pe-check" data-g="border"><input id="pe-border" type="checkbox" /> Box around text</label>

        <div id="pe-sel" class="pe-row pe-selrow">
          <button id="pe-dup" class="pe-btn pe-sm" type="button">Duplicate item</button>
          <button id="pe-del" class="pe-btn pe-sm" type="button">Delete item</button>
        </div>
      </aside>
    </div>

    <p id="pe-status" class="pe-status" role="status" aria-live="polite"></p>
  </div>

  <input id="pe-file" type="file" accept=".pdf,application/pdf,image/*" hidden />
  <input id="pe-file-add" type="file" accept=".pdf,application/pdf,image/*" multiple hidden />
  <input id="pe-img-file" type="file" accept="image/*" hidden />

  <dialog id="pe-export-dlg" class="pe-dlg">
    <form method="dialog">
      <h2>Download your PDF</h2>
      <label class="pe-field">File name
        <input id="pe-fname" type="text" value="document-edited" />
      </label>
      <fieldset class="pe-fs">
        <legend>Format</legend>
        <label class="pe-check"><input id="pe-mode-std" type="radio" name="pe-mode" checked /> Standard (keeps text selectable)</label>
        <label class="pe-check"><input id="pe-mode-flat" type="radio" name="pe-mode" /> Flattened page images (removes text under redactions, can make scans smaller)</label>
        <label class="pe-field">Quality for flattened files
          <select id="pe-quality">
            <option value="high">High (larger file)</option>
            <option value="medium" selected>Medium</option>
            <option value="low">Low (smallest file)</option>
          </select>
        </label>
      </fieldset>
      <fieldset class="pe-fs">
        <legend>Watermark (optional)</legend>
        <label class="pe-field">Text on every page
          <input id="pe-wm-text" type="text" placeholder="For example: Draft" />
        </label>
        <label class="pe-field">Strength
          <input id="pe-wm-op" type="range" min="5" max="60" value="20" />
        </label>
      </fieldset>
      <div class="pe-dlg-actions">
        <button class="pe-btn" value="cancel">Cancel</button>
        <button id="pe-export-go" class="pe-btn pe-primary" type="button">Download PDF</button>
      </div>
    </form>
  </dialog>

  <dialog id="pe-extract-dlg" class="pe-dlg">
    <form method="dialog">
      <h2>Extract or split pages</h2>
      <label class="pe-field">Pages to extract
        <input id="pe-range" type="text" placeholder="For example: 1-3, 5, 8" />
      </label>
      <p id="pe-extract-msg" class="pe-note"></p>
      <div class="pe-dlg-actions">
        <button class="pe-btn" value="cancel">Close</button>
        <button id="pe-split-go" class="pe-btn" type="button">Split every page (ZIP)</button>
        <button id="pe-extract-go" class="pe-btn pe-primary" type="button">Extract to PDF</button>
      </div>
    </form>
  </dialog>

  <dialog id="pe-sig-dlg" class="pe-dlg">
    <form method="dialog">
      <h2>Add your signature</h2>
      <div class="pe-row">
        <label class="pe-check"><input type="radio" name="pe-sigtab" value="draw" checked /> Draw</label>
        <label class="pe-check"><input type="radio" name="pe-sigtab" value="type" /> Type</label>
        <label class="pe-check"><input type="radio" name="pe-sigtab" value="upload" /> Upload</label>
        <label class="pe-field pe-inline">Ink
          <select id="pe-sig-ink">
            <option value="#111827">Black</option>
            <option value="#1d4ed8">Blue</option>
          </select>
        </label>
      </div>

      <div data-sigpanel="draw">
        <canvas id="pe-sig-draw" class="pe-sigcv" width="600" height="200"></canvas>
        <button id="pe-sig-clear" class="pe-btn pe-sm" type="button">Clear</button>
      </div>
      <div data-sigpanel="type" hidden>
        <label class="pe-field">Your name
          <input id="pe-sig-name" type="text" />
        </label>
        <canvas id="pe-sig-type" class="pe-sigcv" width="600" height="200"></canvas>
      </div>
      <div data-sigpanel="upload" hidden>
        <label class="pe-field">Signature image
          <input id="pe-sig-file" type="file" accept="image/*" />
        </label>
        <img id="pe-sig-preview" class="pe-sigprev" alt="" hidden />
      </div>

      <p id="pe-sig-msg" class="pe-note"></p>
      <div class="pe-dlg-actions">
        <button class="pe-btn" value="cancel">Cancel</button>
        <button id="pe-sig-add" class="pe-btn pe-primary" type="button">Add to page</button>
      </div>
    </form>
  </dialog>

  <section class="pe-content">
    <h2>How to edit a PDF online</h2>
    <ol>
      <li>Click <strong>Open file</strong> or drop a PDF (or a PNG or JPG image) onto the editor.</li>
      <li>Pick a tool from the toolbar and click or drag on the page. Use Select to move or resize items.</li>
      <li>Use the page list on the left to reorder, rotate, delete, duplicate, or extract pages.</li>
      <li>Click <strong>Download</strong> to save your edited PDF.</li>
    </ol>

    <h2>Frequently asked questions</h2>
    <h3>Is my PDF uploaded anywhere?</h3>
    <p>No. The editor runs entirely in your browser. Your document never leaves your device.</p>
    <h3>Can I change the existing text in my PDF?</h3>
    <p>Use the Edit text tool. It covers the original words with a white box and places editable text on top. This works well for corrections on plain backgrounds. The original text is still inside the file unless you download the flattened format.</p>
    <h3>How do I permanently black out private information?</h3>
    <p>Draw black boxes with the Redact tool, then choose the flattened format when downloading. Flattened files turn each page into an image, so the hidden text can no longer be selected or copied.</p>
    <h3>How do I sign a PDF?</h3>
    <p>Click Signature, then draw it, type your name, or upload an image. Place it on the page, then drag to move it and use the corner handles to resize it.</p>
    <h3>Can I merge or split PDFs?</h3>
    <p>Yes. Use Add pages to append another PDF, drag thumbnails to reorder, and use Extract to save a page range or split every page into a ZIP.</p>
    <h3>Why can't I open my PDF?</h3>
    <p>Password-protected PDFs cannot be opened here. Remove the password in your PDF viewer first and save a copy.</p>
    <h3>Are my edits still editable after I download?</h3>
    <p>No. Added items are merged into the page as images, so you cannot change them later in other PDF software. Keep your original file if you may need further changes.</p>
  </section>
</ToolLayout>

<style is:global>
  .pe-intro { color: var(--muted); max-width: 760px; }
  .pe-app [hidden] { display: none !important; }
  .pe-app {
    background: #fff; border: 1px solid var(--border); border-top: 5px solid var(--accent);
    border-radius: 14px; overflow: hidden; margin: 20px 0;
    box-shadow: 0 1px 2px rgba(20, 33, 61, 0.04), 0 14px 28px -18px rgba(20, 33, 61, 0.22);
  }
  .pe-bar { display: flex; flex-wrap: wrap; gap: 6px 4px; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .pe-group { display: flex; gap: 4px; align-items: center; padding-right: 10px; margin-right: 6px; border-right: 1px solid var(--border); }
  .pe-group:last-child { border-right: 0; }
  .pe-pageinfo { margin-left: auto; color: var(--muted); font-size: 0.9rem; font-weight: 600; }
  .pe-btn {
    background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 7px 11px;
    font: 600 0.88rem var(--font-body); color: var(--text); cursor: pointer; white-space: nowrap;
  }
  .pe-btn:hover:not(:disabled) { border-color: var(--accent); }
  .pe-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .pe-btn.pe-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pe-btn.pe-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pe-btn.pe-sm { padding: 5px 8px; font-size: 0.8rem; }
  .pe-select, .pe-app select, .pe-app textarea, .pe-app input[type="text"], .pe-app input[type="number"] {
    border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; font: 0.9rem var(--font-body);
    background: #fff; color: var(--text); width: 100%;
  }
  .pe-bar .pe-select { width: auto; }

  .pe-main { display: grid; grid-template-columns: 160px minmax(0, 1fr) 250px; height: min(78vh, 880px); min-height: 520px; }
  .pe-left { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; background: #fafbff; }
  .pe-pageops { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; border-bottom: 1px solid var(--border); }
  .pe-thumbs { overflow: auto; padding: 10px 8px; flex: 1; position: relative; display: grid; gap: 10px; align-content: start; justify-items: center; }
  .pe-thumb { cursor: pointer; text-align: center; font-size: 0.78rem; color: var(--muted); border: 2px solid transparent; border-radius: 8px; padding: 4px; }
  .pe-thumb canvas { display: block; background: #fff; box-shadow: 0 1px 4px rgba(20, 33, 61, 0.28); }
  .pe-thumb.pe-cur { border-color: var(--accent); }
  .pe-thumb.pe-over { outline: 2px dashed var(--accent); }

  .pe-stage { overflow: auto; background: #e9edf5; position: relative; min-width: 0; }
  .pe-stage.pe-drag { outline: 3px dashed var(--accent); outline-offset: -6px; }
  .pe-pages { width: max-content; min-width: 100%; padding: 6px 20px 24px; }
  .pe-page { position: relative; margin: 14px auto; background: #fff; box-shadow: 0 2px 10px rgba(20, 33, 61, 0.28); }
  .pe-pdf, .pe-ov { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
  .pe-ov { cursor: crosshair; touch-action: none; }
  .pe-stage[data-tool="select"] .pe-ov { cursor: default; touch-action: pan-x pan-y pinch-zoom; }
  .pe-stage[data-tool="text"] .pe-ov, .pe-stage[data-tool="edittext"] .pe-ov { cursor: text; }
  .pe-pnum { position: absolute; right: 8px; bottom: 6px; background: rgba(20, 33, 61, 0.7); color: #fff; font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; pointer-events: none; }
  .pe-empty { display: grid; place-items: center; text-align: center; height: 100%; padding: 24px; color: var(--muted); }
  .pe-empty-title { font: 800 1.4rem var(--font-display); color: var(--ink); margin: 0 0 6px; }

  .pe-right { border-left: 1px solid var(--border); padding: 12px; overflow: auto; display: flex; flex-direction: column; gap: 10px; background: #fafbff; }
  .pe-h { margin: 0; font: 800 1.05rem var(--font-display); color: var(--ink); }
  .pe-note { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .pe-field { display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; font-weight: 600; }
  .pe-field.pe-inline { flex-direction: row; align-items: center; gap: 8px; margin-left: auto; }
  .pe-field.pe-inline select { width: auto; }
  .pe-field input[type="color"] { height: 36px; padding: 2px; width: 100%; border: 1px solid var(--border); border-radius: 8px; background: #fff; }
  .pe-check { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 500; }
  .pe-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .pe-selrow { margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--border); gap: 6px; }
  .pe-status { margin: 0; padding: 8px 14px; border-top: 1px solid var(--border); font-size: 0.88rem; color: var(--muted); min-height: 2.2em; }
  .pe-status.pe-bad { color: #c62828; font-weight: 600; }

  .pe-dlg { border: 0; border-radius: 14px; padding: 22px; width: min(580px, 92vw); box-shadow: 0 24px 60px -20px rgba(20, 33, 61, 0.5); }
  .pe-dlg::backdrop { background: rgba(20, 33, 61, 0.5); }
  .pe-dlg h2 { margin: 0 0 12px; font-family: var(--font-display); }
  .pe-dlg form { display: grid; gap: 12px; }
  .pe-fs { border: 1px solid var(--border); border-radius: 10px; display: grid; gap: 8px; padding: 10px 12px; margin: 0; }
  .pe-fs legend { font-weight: 700; font-size: 0.9rem; padding: 0 6px; }
  .pe-dlg-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
  .pe-sigcv { width: 100%; height: auto; border: 1px dashed var(--border); border-radius: 10px; background: #fff; touch-action: none; display: block; margin-bottom: 8px; }
  .pe-sigprev { max-width: 100%; max-height: 160px; margin-top: 8px; }

  main .pe-content { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 6px 26px 22px; max-width: 820px; margin-top: 36px; }
  main .pe-content h2 { font-family: var(--font-display); color: var(--accent); margin-top: 22px; }
  main .pe-content h3 { margin: 18px 0 4px; font-size: 1rem; color: var(--ink); }
  main .pe-content p { margin: 0 0 8px; }

  @media (max-width: 980px) {
    .pe-main { grid-template-columns: 1fr; height: auto; }
    .pe-left { border-right: 0; border-bottom: 1px solid var(--border); }
    .pe-thumbs { display: flex; overflow-x: auto; padding: 8px; }
    .pe-stage { height: 70vh; }
    .pe-right { border-left: 0; border-top: 1px solid var(--border); }
    .pe-pageinfo { margin-left: 0; }
  }
</style>

<script>
  import "../scripts/pdf-editor.js";
</script>