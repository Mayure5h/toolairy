---
import ToolLayout from "../layouts/ToolLayout.astro";
---
<ToolLayout
  wide
  title="Passport Photo Maker: Crop, Resize and Print Photos in cm, mm and Inches"
  description="Free passport photo maker. Crop and resize photos to exact sizes in cm, mm, or inches, check print resolution, lay out several copies on A4, Letter, or 4x6 paper, then print or download a PDF. Runs in your browser."
>
  <h1>Passport Photo Maker and Print Layout</h1>
  <p class="pp-intro">
    Crop and resize a photo to an exact physical size, preview it on real paper sizes, repeat it
    across a sheet with cutting guides, then print it or save a print-ready PDF. Your photo never
    leaves your browser.
  </p>

  <div class="pp-app">
    <aside class="pp-side">
      <details open class="pp-sec">
        <summary>1. Upload photo</summary>
        <div class="pp-body">
          <label class="pp-drop" id="pp-drop" for="pp-file">
            <strong>Drop a photo here</strong>
            <span>or click to choose (JPG, PNG, WebP)</span>
          </label>
          <input id="pp-file" type="file" accept="image/*,.tif,.tiff" hidden />
          <dl id="pp-meta" class="pp-meta" hidden>
            <div><dt>Pixels</dt><dd id="pp-m-px"></dd></div>
            <div><dt>File size</dt><dd id="pp-m-size"></dd></div>
            <div><dt>Megapixels</dt><dd id="pp-m-mp"></dd></div>
            <div><dt>Type</dt><dd id="pp-m-type"></dd></div>
          </dl>
          <p id="pp-upmsg" class="pp-note"></p>
        </div>
      </details>

      <details open class="pp-sec">
        <summary>2. Size and resolution</summary>
        <div class="pp-body">
          <label class="pp-field">Common sizes
            <select id="pp-preset"></select>
          </label>
          <label class="pp-field">Units
            <select id="pp-unit">
              <option value="mm">Millimeters (mm)</option>
              <option value="cm">Centimeters (cm)</option>
              <option value="in">Inches (in)</option>
              <option value="px">Pixels (px)</option>
            </select>
          </label>
          <div class="pp-two">
            <label class="pp-field">Width
              <input id="pp-w" type="number" min="0.1" step="0.1" inputmode="decimal" />
            </label>
            <label class="pp-field">Height
              <input id="pp-h" type="number" min="0.1" step="0.1" inputmode="decimal" />
            </label>
          </div>
          <label class="pp-check"><input id="pp-lock" type="checkbox" checked /> Lock aspect ratio</label>
          <fieldset class="pp-fs">
            <legend>Crop mode</legend>
            <label class="pp-check"><input type="radio" name="pp-mode" value="fixed" checked /> Fixed size (crop box matches the size above)</label>
            <label class="pp-check"><input type="radio" name="pp-mode" value="free" /> Freeform (crop any shape)</label>
          </fieldset>
          <div class="pp-field">Resolution (DPI)
            <div class="pp-chips">
              <button type="button" class="pp-chip" data-dpi="72">72 screen</button>
              <button type="button" class="pp-chip" data-dpi="150">150 draft</button>
              <button type="button" class="pp-chip pp-on" data-dpi="300">300 standard</button>
              <button type="button" class="pp-chip" data-dpi="600">600 fine art</button>
            </div>
            <input id="pp-dpi" type="number" min="50" max="1200" step="1" value="300" aria-label="Custom DPI" />
          </div>
          <p id="pp-readout" class="pp-readout"></p>
          <p id="pp-quality" class="pp-note"></p>
          <p id="pp-low" class="pp-low" hidden></p>
        </div>
      </details>

      <details open class="pp-sec">
        <summary>3. Crop and orientation</summary>
        <div class="pp-body">
          <label class="pp-field">Rotation: <span id="pp-rotval">0&deg;</span>
            <input id="pp-rot" type="range" min="-180" max="180" step="1" value="0" />
          </label>
          <div class="pp-chips">
            <button type="button" class="pp-btn pp-sm" id="pp-rotm" data-needs-img>Rotate -90&deg;</button>
            <button type="button" class="pp-btn pp-sm" id="pp-rotp" data-needs-img>Rotate +90&deg;</button>
            <button type="button" class="pp-btn pp-sm" id="pp-flipx" data-needs-img>Flip horizontal</button>
            <button type="button" class="pp-btn pp-sm" id="pp-flipy" data-needs-img>Flip vertical</button>
          </div>
          <label class="pp-field">Background color (fills empty corners)
            <input id="pp-bg" type="color" value="#ffffff" />
          </label>
          <p id="pp-croplabel" class="pp-note"></p>
        </div>
      </details>

      <details open class="pp-sec">
        <summary>4. Paper sheet and layout</summary>
        <div class="pp-body">
          <label class="pp-field">Paper size
            <select id="pp-paper"></select>
          </label>
          <div class="pp-two">
            <label class="pp-field">Orientation
              <select id="pp-orient">
                <option value="portrait">Portrait</option>
                <option value="landscape">Landscape</option>
              </select>
            </label>
            <label class="pp-field">Margin
              <select id="pp-margin">
                <option value="0">None</option>
                <option value="3">3 mm</option>
                <option value="5" selected>5 mm</option>
                <option value="10">10 mm</option>
                <option value="12.7">0.5 in</option>
              </select>
            </label>
          </div>
          <div class="pp-field">Position on sheet
            <div class="pp-chips">
              <button type="button" class="pp-chip pp-on" data-align="center">Center</button>
              <button type="button" class="pp-chip" data-align="topleft">Top-left</button>
              <button type="button" class="pp-chip" data-align="custom">Custom (drag)</button>
            </div>
          </div>
          <label class="pp-check"><input id="pp-multi" type="checkbox" /> Repeat the photo to fill the sheet</label>
          <div class="pp-two">
            <label class="pp-field">Gap (mm)
              <input id="pp-gap" type="number" min="0" max="30" step="0.5" value="3" />
            </label>
            <label class="pp-field">Copies (blank = fill)
              <input id="pp-copies" type="number" min="1" max="200" step="1" placeholder="Fill" />
            </label>
          </div>
          <label class="pp-check"><input id="pp-guides" type="checkbox" checked /> Show cutting guides</label>
          <label class="pp-field">Ruler units
            <select id="pp-runit">
              <option value="cm">Centimeters</option>
              <option value="in">Inches</option>
            </select>
          </label>
          <p id="pp-count" class="pp-note"></p>
        </div>
      </details>

      <details class="pp-sec">
        <summary>5. Image download options</summary>
        <div class="pp-body">
          <label class="pp-field">Format
            <select id="pp-fmt">
              <option value="jpeg">JPEG (smaller file)</option>
              <option value="png">PNG (lossless)</option>
            </select>
          </label>
          <label class="pp-field">JPEG quality: <span id="pp-qval">92</span>
            <input id="pp-q" type="range" min="50" max="100" value="92" />
          </label>
          <p class="pp-note">The image is saved at the exact pixel size above, with the DPI stored in the file.</p>
        </div>
      </details>
    </aside>

    <section class="pp-main">
      <div class="pp-actions">
        <div class="pp-seg" role="group" aria-label="View">
          <button type="button" class="pp-segbtn pp-on" data-tab="edit">Edit view</button>
          <button type="button" class="pp-segbtn" data-tab="prev">Print preview</button>
        </div>
        <div id="pp-zoomgrp" class="pp-seg" role="group" aria-label="Preview zoom" hidden>
          <button type="button" class="pp-segbtn pp-on" data-zoom="fit">Fit</button>
          <button type="button" class="pp-segbtn" data-zoom="0.5">50%</button>
          <button type="button" class="pp-segbtn" data-zoom="1">100%</button>
        </div>
        <span class="pp-spacer"></span>
        <button type="button" class="pp-btn" id="pp-reset" data-needs-img>Reset</button>
        <button type="button" class="pp-btn" id="pp-print" data-needs-img>Print</button>
        <button type="button" class="pp-btn" id="pp-pdf" data-needs-img>Download PDF</button>
        <button type="button" class="pp-btn pp-primary" id="pp-dl" data-needs-img>Download image</button>
      </div>

      <div class="pp-stage">
        <div id="pp-pane-edit" class="pp-pane">
          <div id="pp-empty" class="pp-empty">
            <div>
              <p class="pp-empty-title">Add a photo to start</p>
              <p>Drop a file onto the upload box, or choose one from your device. Nothing is uploaded.</p>
              <label class="pp-btn pp-primary" for="pp-file">Choose a photo</label>
            </div>
          </div>
          <div id="pp-editwrap" class="pp-editwrap" hidden>
            <img id="pp-img" alt="Photo to crop" />
          </div>
        </div>

        <div id="pp-pane-prev" class="pp-pane pp-off">
          <div id="pp-prev-empty" class="pp-empty">
            <div><p class="pp-empty-title">No photo yet</p><p>Add a photo to see the print preview.</p></div>
          </div>
          <div id="pp-prevscroll" class="pp-prevscroll" hidden>
            <canvas id="pp-prevcv"></canvas>
          </div>
          <p id="pp-badge" class="pp-badge" hidden></p>
        </div>

        <div id="pp-busy" class="pp-busy" hidden>
          <div class="pp-spin"></div>
          <p id="pp-busy-msg">Working...</p>
        </div>
      </div>
      <p id="pp-status" class="pp-status" role="status" aria-live="polite"></p>
    </section>
  </div>

  <section class="pp-content">
    <h2>How to make a passport photo online</h2>
    <ol>
      <li>Upload a clear, front-facing photo with even lighting.</li>
      <li>Choose a size, such as 35 &times; 45 mm or 2 &times; 2 in, and move the crop box over the face.</li>
      <li>Check the resolution note. Aim for at least 300 DPI for sharp prints.</li>
      <li>Open Print preview, pick a paper size, and turn on Repeat to fill the sheet.</li>
      <li>Print the sheet, save it as a PDF, or download the single photo.</li>
    </ol>

    <h2>Frequently asked questions</h2>
    <h3>Is my photo uploaded anywhere?</h3>
    <p>No. Cropping, resizing, and exporting all happen in your browser. Your photo never leaves your device.</p>
    <h3>Will the photo meet official passport rules?</h3>
    <p>This tool sets the exact size and layout but does not check face position, background, or expression. Rules differ by country, so check the official requirements for yours.</p>
    <h3>What DPI should I use?</h3>
    <p>300 DPI is the standard for sharp photo prints. 150 DPI is fine for drafts, and 600 DPI is for fine art or archives. A warning appears when your photo gives less than 200 DPI at the chosen size.</p>
    <h3>How do I print at the exact size?</h3>
    <p>In the print dialog, set Scale to 100% (or "Actual size"), turn off Fit to page, and set Margins to None. Print a test page first and measure it with a ruler.</p>
    <h3>Why did my TIFF file not open?</h3>
    <p>Most browsers cannot display TIFF images. Convert the file to JPG or PNG first.</p>
    <h3>Why is my file name or quality different from the original?</h3>
    <p>The downloaded image is resampled to the exact pixel size for your chosen DPI. JPEG is smaller. PNG is lossless but larger.</p>
  </section>
</ToolLayout>

<style is:global>
  .pp-intro { color: var(--muted); max-width: 760px; }
  .pp-app [hidden] { display: none !important; }
  .pp-app { display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: 18px; margin: 20px 0; align-items: start; }
  .pp-side { display: grid; gap: 10px; }
  .pp-sec {
    background: #fff; border: 1px solid var(--border); border-top: 4px solid var(--accent);
    border-radius: 12px; overflow: hidden;
  }
  .pp-sec summary { cursor: pointer; padding: 12px 14px; font: 800 1rem var(--font-display); color: var(--ink); }
  .pp-body { padding: 2px 14px 14px; display: grid; gap: 10px; }
  .pp-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pp-field { display: grid; gap: 4px; font-size: 0.85rem; font-weight: 600; }
  .pp-app select, .pp-app input[type="number"], .pp-app input[type="text"] {
    border: 1px solid var(--border); border-radius: 8px; padding: 8px 9px; font: 0.95rem var(--font-body);
    background: #fff; color: var(--text); width: 100%;
  }
  .pp-app input[type="color"] { height: 38px; width: 100%; padding: 2px; border: 1px solid var(--border); border-radius: 8px; background: #fff; }
  .pp-check { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 500; }
  .pp-fs { border: 1px solid var(--border); border-radius: 10px; margin: 0; padding: 8px 12px; display: grid; gap: 6px; }
  .pp-fs legend { padding: 0 6px; font-weight: 700; font-size: 0.85rem; }
  .pp-note { margin: 0; color: var(--muted); font-size: 0.85rem; }
  .pp-readout { margin: 0; padding: 10px 12px; background: var(--bg); border-radius: 8px; font-size: 0.85rem; white-space: pre-line; }
  .pp-low, .pp-badge {
    margin: 0; background: #fff4e5; color: #8a4b00; border: 1px solid #ffd8a8; border-radius: 8px;
    padding: 8px 10px; font-size: 0.85rem; font-weight: 700;
  }
  .pp-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .pp-chip, .pp-btn, .pp-segbtn {
    background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 7px 11px;
    font: 600 0.88rem var(--font-body); color: var(--text); cursor: pointer; text-decoration: none; display: inline-block;
  }
  .pp-chip:hover, .pp-btn:hover:not(:disabled) { border-color: var(--accent); }
  .pp-chip.pp-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pp-btn.pp-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pp-btn.pp-sm { padding: 6px 9px; font-size: 0.82rem; }
  .pp-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .pp-seg { display: inline-flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .pp-segbtn { border: 0; border-radius: 0; }
  .pp-segbtn + .pp-segbtn { border-left: 1px solid var(--border); }
  .pp-segbtn.pp-on { background: var(--accent); color: #fff; }

  .pp-drop {
    display: grid; gap: 4px; text-align: center; padding: 22px 12px; cursor: pointer;
    border: 2px dashed color-mix(in srgb, var(--accent) 40%, white); border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 6%, white);
  }
  .pp-drop span { color: var(--muted); font-size: 0.88rem; }
  .pp-drop.pp-over { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, white); }
  .pp-meta { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 0.85rem; }
  .pp-meta div { background: var(--bg); border-radius: 8px; padding: 6px 10px; }
  .pp-meta dt { color: var(--muted); font-size: 0.75rem; }
  .pp-meta dd { margin: 0; font-weight: 700; }

  .pp-main {
    min-width: 0; display: grid; gap: 10px;
    position: sticky; top: var(--pp-top, 84px); align-self: start; z-index: 6;
  }
  .pp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pp-spacer { flex: 1; }
  .pp-stage {
    position: relative; height: min(calc(100vh - 200px), 780px); min-height: 360px; background: #2b3245;
    border-radius: 12px; overflow: hidden; border: 1px solid #1c2233;
  }
  .pp-pane { position: relative; width: 100%; height: 100%; }
  .pp-pane.pp-off { position: absolute; left: 0; top: 0; visibility: hidden; pointer-events: none; }
  .pp-editwrap { width: 100%; height: 100%; }
  .pp-editwrap img { display: block; max-width: 100%; }
  .pp-empty { display: grid; place-items: center; text-align: center; height: 100%; padding: 24px; color: #c9d3ea; }
  .pp-empty-title { font: 800 1.4rem var(--font-display); color: #fff; margin: 0 0 6px; }
  .pp-prevscroll { position: absolute; inset: 0; overflow: auto; }
  .pp-prevscroll canvas { display: block; margin: 0 auto; touch-action: pan-x pan-y pinch-zoom; }
  .pp-badge { position: absolute; left: 12px; top: 12px; max-width: 70%; z-index: 3; }
  .pp-busy {
    position: absolute; inset: 0; background: rgba(20, 33, 61, 0.72); color: #fff; z-index: 5;
    display: grid; place-content: center; justify-items: center; gap: 12px;
  }
  .pp-spin { width: 34px; height: 34px; border: 4px solid rgba(255, 255, 255, 0.3); border-top-color: #fff; border-radius: 50%; animation: pp-rot 0.8s linear infinite; }
  @keyframes pp-rot { to { transform: rotate(360deg); } }
  .pp-status { margin: 0; min-height: 1.6em; font-size: 0.9rem; color: var(--muted); }
  .pp-status.pp-bad { color: #c62828; font-weight: 600; }

  /* cropper theme */
  .cropper-view-box { outline-color: var(--accent); }
  .cropper-line, .cropper-point { background-color: var(--accent); }

  main .pp-content { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 6px 26px 22px; max-width: 820px; margin-top: 36px; }
  main .pp-content h2 { font-family: var(--font-display); color: var(--accent); margin-top: 22px; }
  main .pp-content h3 { margin: 18px 0 4px; font-size: 1rem; color: var(--ink); }
  main .pp-content p { margin: 0 0 8px; }

  @media (max-width: 980px) {
    .pp-app { grid-template-columns: 1fr; }
    .pp-main { order: -1; background: var(--bg); padding-bottom: 6px; }
    .pp-stage { height: 36vh; min-height: 220px; }
    .pp-actions { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
    .pp-actions > * { flex-shrink: 0; }
  }

  /* printing: show only the sheet that the script builds */
  #pp-print { display: none; }
  @media print {
    body > *:not(#pp-print) { display: none !important; }
    html, body { background: #fff !important; margin: 0 !important; padding: 0 !important; }
    #pp-print { display: block !important; }
    #pp-print * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  import "../scripts/photo-print.js";
</script>