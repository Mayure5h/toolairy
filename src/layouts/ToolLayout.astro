---
import "@fontsource-variable/figtree";
import "@fontsource-variable/bricolage-grotesque";
import { TOOLS, BRAND } from "../data/tools.js";

const { title, description, wide = false } = Astro.props;
const SITE_NAME = "Toolairy";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = TOOLS.find((t) => t.href === path);
const accent = current ? current.color : BRAND;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4A5CF0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
  </head>
  <body style={`--accent: ${accent};`}>
    <header class="site-header">
      <div class="wrap hdr">
        <a href="/" class="brand" aria-label="Toolairy home">
          <!-- LOGO: replace /logo.svg with your own file. If your logo already
               contains the name "Toolairy", delete the brand-name span below. -->
          <img src="/logo.svg" alt="" width="40" height="40" class="brand-logo" />
          <span class="brand-name">{SITE_NAME}</span>
        </a>

        <nav class="main-nav" aria-label="Tools">
          {TOOLS.map((t) => (
            <a
              href={t.href}
              class="nav-link"
              style={`--c: ${t.color};`}
              aria-current={path === t.href ? "page" : undefined}
            >
              {t.short}
            </a>
          ))}
        </nav>

        <span class="private-pill">Files stay on your device</span>
      </div>
      <div class="rainbow"></div>
    </header>

    <main class={wide ? "wrap-wide" : "wrap"}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div>
          <div class="foot-brand">
            <img src="/logo.svg" alt="" width="32" height="32" class="brand-logo" />
            <span>{SITE_NAME}</span>
          </div>
          <p class="foot-text">Free tools that run in your browser. Your files never leave your device.</p>
        </div>
        <div>
          <p class="foot-h">Tools</p>
          <ul class="foot-list">
            {TOOLS.map((t) => (<li><a href={t.href}>{t.name}</a></li>))}
          </ul>
        </div>
        <div>
          <p class="foot-h">Site</p>
          <ul class="foot-list">
            <li><a href="/about">About</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap foot-base">© {new Date().getFullYear()} {SITE_NAME}</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f8ff;
    --card: #ffffff;
    --ink: #14213d;
    --text: #14213d;
    --muted: #55627d;
    --accent: #4a5cf0;
    --border: #dde5f3;
    --font-body: "Figtree Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --font-display: "Bricolage Grotesque Variable", "Figtree Variable", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--text);
    line-height: 1.6;
    background:
      radial-gradient(900px 380px at 88% -80px, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(700px 320px at 0% -60px, color-mix(in srgb, #2cb1f5 14%, transparent), transparent 70%),
      var(--bg);
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  .wrap-wide { max-width: 1480px; margin: 0 auto; padding: 0 20px; }
  a { color: var(--accent); }
  :focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 55%, white); outline-offset: 2px; }

  /* ---------- header ---------- */
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .hdr { display: flex; align-items: center; gap: 16px; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .brand-logo { display: block; height: 40px; width: auto; max-width: 160px; border-radius: 10px; }
  .brand-name { font-family: var(--font-display); font-weight: 800; font-size: 1.45rem; letter-spacing: -0.02em; }
  .main-nav { display: flex; gap: 4px; margin-left: auto; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 12px; border-radius: 999px;
    color: var(--ink); text-decoration: none;
    font-weight: 600; font-size: 0.92rem; white-space: nowrap;
  }
  .nav-link::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .nav-link:hover { background: color-mix(in srgb, var(--c) 12%, white); }
  .nav-link[aria-current="page"] { background: color-mix(in srgb, var(--c) 18%, white); }
  .private-pill {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.8rem; font-weight: 700; color: #0b6e5f; background: #e3f7f1;
    border-radius: 999px; padding: 6px 12px; white-space: nowrap;
  }
  .private-pill::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #12b886; }
  .rainbow { height: 4px; background: linear-gradient(90deg, #2cb1f5, #0e8a7d, #6d4aff, #d6336c, #c2570c, #ffb020); }

  @media (max-width: 1180px) { .private-pill { display: none; } }
  @media (max-width: 760px) {
    .hdr { flex-wrap: wrap; padding-top: 10px; padding-bottom: 6px; min-height: 0; gap: 6px; }
    .main-nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; padding-bottom: 6px; }
  }

  /* ---------- page headings ---------- */
  main > h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    line-height: 1.1; letter-spacing: -0.02em;
    margin: 40px 0 12px; color: var(--ink);
  }
  main > h1::after {
    content: ""; display: block; width: 64px; height: 6px;
    border-radius: 6px; margin-top: 14px; background: var(--accent);
  }
  main > h2 { font-family: var(--font-display); color: var(--ink); }

  /* ---------- buttons ---------- */
  .btn {
    background: var(--accent); color: #fff; border: 0; border-radius: 10px;
    padding: 11px 20px; font-size: 1rem; font-weight: 700; font-family: inherit; cursor: pointer;
    box-shadow: 0 8px 18px -10px var(--accent);
  }
  .btn:hover:not(:disabled) { filter: brightness(0.93); }

  /* ---------- tool page panels (inherit the page color) ---------- */
  main :is(.rn-box, .cj-box, .pm-box, .cc-box) {
    border-top: 5px solid var(--accent);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(20, 33, 61, 0.04), 0 14px 28px -18px rgba(20, 33, 61, 0.22);
  }
  main :is(.rn-box, .cj-box, .pm-box, .cc-box) h2 { font-family: var(--font-display); color: var(--ink); }
  main :is(.rn-drop, .pm-drop) {
    background: color-mix(in srgb, var(--accent) 6%, white);
    border-color: color-mix(in srgb, var(--accent) 35%, white);
  }
  main :is(.rn-over, .pm-over) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, white);
  }
  main :is(.rn-content, .cj-content, .pm-content, .cc-content) {
    background: #fff; border: 1px solid var(--border); border-radius: 14px;
    padding: 6px 26px 22px; max-width: 820px;
  }
  main :is(.rn-content, .cj-content, .pm-content, .cc-content) h2 {
    font-family: var(--font-display); color: var(--accent);
  }
  main :is(.rn-content, .cj-content, .pm-content, .cc-content) h3 { color: var(--ink); }

  /* ---------- footer ---------- */
  .site-footer { margin-top: 64px; background: #14213d; color: #c9d3ea; padding-top: 40px; }
  .site-footer a { color: #fff; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 32px; }
  .foot-brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; color: #fff; }
  .foot-text { margin: 10px 0 0; max-width: 320px; font-size: 0.92rem; }
  .foot-h { margin: 0 0 10px; font-weight: 700; color: #fff; }
  .foot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 0.95rem; }
  .foot-base { margin-top: 32px; padding-top: 18px; padding-bottom: 24px; border-top: 1px solid #2a3a60; font-size: 0.85rem; }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>